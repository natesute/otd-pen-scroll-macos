<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>PenScroll</AssemblyName>
    <RootNamespace>PenScroll</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Authors>Nathan Suttie, Matsuda Tetsuya</Authors>
    <Description>Hold a pen button and move the pen to scroll, like two fingers on a trackpad. macOS port of otd-pen-scroll.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/natesute/otd-pen-scroll-macos</RepositoryUrl>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile-time only: a second copy of this assembly breaks type identity at load. -->
    <PackageReference Include="OpenTabletDriver.Plugin" Version="0.6.7">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
